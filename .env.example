# ============================================
# LLM (DeepSeek)
# ============================================
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat          # V3.2 non-thinking mode
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=1.3              # For creative scripts

# ============================================
# TTS (Text-to-Speech)
# ============================================
TTS_PROVIDER=fish_audio
FISH_AUDIO_API_KEY=
ELEVENLABS_API_KEY=              # leave empty if using Fish Audio
TTS_VOICE_ID=             # see note below

# ============================================
# Images
# ============================================
# Images (Google Gemini — FREE)
IMAGE_PROVIDER=gemini
# IMAGE_PROVIDER=pollinations
# IMAGE_PROVIDER=replicate_flux
POLLINATIONS_MODEL=gptimage-large          # flux | turbo | flux-pro | gptimage1
IMAGE_WIDTH=1024
IMAGE_HEIGHT=576
POLLINATIONS_API_KEY=
REPLICATE_API_TOKEN=
FLUX_MODEL=black-forest-labs/flux-1.1-pro
GOOGLE_AI_API_KEY=        # Get from aistudio.google.com/apikey
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
NSFW_CHECK_ENABLED=true

# ============================================
# YouTube
# ============================================
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/token.json
YOUTUBE_CHANNEL_ID=

# ============================================
# Scheduling
# ============================================
VIDEOS_PER_DAY=2
PUBLISH_HOURS_UTC=10,20
ENABLE_CAPTIONS=true

# ============================================
# Alerts (pick one)
# ============================================
DISCORD_WEBHOOK_URL=


# ============================================
# Storage
# ============================================
OUTPUT_DIR=./outputs
DB_URL=sqlite:///./chill_agent.db
CLEANUP_AFTER_UPLOAD=true          # delete images/audio/video after successful upload to save disk
